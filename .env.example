#--------------------------------------------------------------------
# Example Environment Configuration file
#
# Copy this file to .env and adjust the settings for your environment:
#   cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# WEBHOOK & DEPLOY CONFIGURATION
#--------------------------------------------------------------------
# Secret used by App\Controllers\Webhook to validate GitHub HMAC signatures
WEBHOOK_SECRET = 'your-github-webhook-secret-here'

# Email used for Let's Encrypt / Certbot SSL registration
CERTBOT_EMAIL = 'admin@example.com'

# Fallback GitHub username or organization
DEFAULT_GITHUB_USER = 'your-github-username'

